# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings → API.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never prefix with NEXT_PUBLIC_, never commit, never ship to
# the browser. Used only for Admin actions (e.g. creating logins).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
